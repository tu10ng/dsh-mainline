                "attrs": {},
                "children": []
              },
              {
                "id": "hl05",
                "kind": "ref",
                "title": "新盘",
                "state": "",
                "question": false,
                "body": "两块 8T 的 CMR 盘，装在 nas-a；购买记录见设计笔记。",
                "attrs": {},
                "children": []
              },
              {
                "id": "hl06",
                "kind": "ref",
                "title": "zpool 布局",
                "state": "",
                "question": false,
                "body": "nas-a 用 raidz1，nas-b 用单盘 + 定期 send/recv。",
                "attrs": {},
                "children": []
              }
            ]
          },
          {
